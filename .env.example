# Copie este arquivo exemplo para seu .env e preencha os valores abaixo antes de iniciar o compose.

# Servidor HTTP
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# API
API_BASE_URL=http://localhost:3000
API_VERSION=v1
API_TIMEOUT=30000

# Cabecalhos, CORS e limites de requisicao
ENABLE_COOP_COEP=true
CORS_ORIGIN=*
CORS_CREDENTIALS=true
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Acesso ao painel administrativo
ADMIN_USERNAME=teste
ADMIN_PASSWORD=teste1234
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=5

# Persistencia em arquivo usada como fallback
DATA_DIR=/app/data
LOG_FILE=fingerprints.json
STATS_FILE=stats.json
MAX_LOG_SIZE_MB=100
MAX_FINGERPRINT_AGE_DAYS=30

# Logs da aplicacao
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_CONSOLE_LOG=true

# Funcionalidades expostas pela configuracao da API
ENABLE_CANVAS=true
ENABLE_WEBGL=true
ENABLE_AUDIO=true
ENABLE_BROWSER_FINGERPRINT=true
ENABLE_ANALYTICS=true

# PostgreSQL criado pelo Docker Compose
POSTGRES_USER=teste
POSTGRES_PASSWORD=teste1234
POSTGRES_DB=fingerprint_db

# Conexao da aplicacao com o PostgreSQL
# No Compose, host, usuario, senha e nome sao alinhados automaticamente com
# POSTGRES_USER, POSTGRES_PASSWORD e POSTGRES_DB.
DB_TYPE=postgres
DB_ENABLED=true
DB_HOST=wasm-db
DB_PORT=5432
DB_NAME=fingerprint_db
DB_USER=teste
DB_PASSWORD=teste1234
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true


## Experimental!
# Alternativa para ambientes que fornecem uma URL unica de conexao.
# Deixe vazia ao utilizar as variaveis DB_* acima.
DATABASE_URL=
PGSSLMODE=disable
